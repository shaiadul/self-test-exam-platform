# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL / Neon DB)
# Example local: postgresql://postgres:password@localhost:5432/selftest_db?sslmode=disable
# Example Neon: postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/selftest_db?sslmode=disable"

# JWT Secret Key for Authentication Tokens
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Admin and Teacher seed emails (optional overrides)
NEXT_PUBLIC_ADMIN_EMAIL="admin@test.com"
NEXT_PUBLIC_TEACHER_EMAIL="teacher@test.com"
