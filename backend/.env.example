# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL / Supabase)
# Supabase: Project Settings -> Database -> Connection string.
# Use the SESSION POOLER (port 5432) for a long-running server: it is IPv4 and
# supports prepared statements. The direct connection (db.<ref>.supabase.co) is
# IPv6-only and fails on networks without IPv6 ("network is unreachable").
# The pooler username is "postgres.<project-ref>", not just "postgres".
# Example local: postgresql://postgres:password@localhost:5432/selftest_db?sslmode=disable
# Example Supabase session pooler:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Example Supabase transaction pooler (serverless only, port 6543):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/selftest_db?sslmode=disable"

# JWT Secret Key for Authentication Tokens
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Admin and Teacher seed emails (optional overrides)
NEXT_PUBLIC_ADMIN_EMAIL="admin@test.com"
NEXT_PUBLIC_TEACHER_EMAIL="teacher@test.com"

# Frontend URL (for OAuth callbacks and redirects)
FRONTEND_URL="http://localhost:3000"

# Social Login / Go OAuth Configuration
# Google OAuth (from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8080/api/auth/oauth/google/callback"

# GitHub OAuth (from GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_REDIRECT_URI="http://localhost:8080/api/auth/oauth/github/callback"

# S3-Compatible Object Storage (Cloudflare R2, IDrive e2, AWS S3, etc.)
# --------------------------------------------------------------------------
# For Cloudflare R2:
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="self-test-bucket"
# S3_ACCESS_KEY_ID="<R2_ACCESS_KEY_ID>"
# S3_SECRET_ACCESS_KEY="<R2_SECRET_ACCESS_KEY>"
# S3_PUBLIC_URL="https://pub-<HASH>.r2.dev" (or custom domain: https://assets.yourdomain.com)
#
# For IDrive e2:
# S3_ENDPOINT="https://<BUCKET_NAME>.<REGION>.idrivee2-*.com" (or your endpoint URL)
# S3_REGION="us-east-1"
# S3_BUCKET="self-test-bucket"
# S3_ACCESS_KEY_ID="<IDRIVE_KEY>"
# S3_SECRET_ACCESS_KEY="<IDRIVE_SECRET>"
# S3_PUBLIC_URL="" (optional, public CDN or custom domain URL)
# --------------------------------------------------------------------------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"
