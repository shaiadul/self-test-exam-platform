# Backend API Base URL
NEXT_PUBLIC_API_URL="http://localhost:8080/api"

# Application Public Base URL (Used for sharing routes and absolute URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Credentials / Default Login Shortcuts (Optional)
NEXT_PUBLIC_STUDENT_EMAIL="student@test.com"
NEXT_PUBLIC_STUDENT_PASSWORD="student123"

NEXT_PUBLIC_TEACHER_EMAIL="teacher@test.com"
NEXT_PUBLIC_TEACHER_PASSWORD="teacher@test.com"

NEXT_PUBLIC_ADMIN_EMAIL="admin@test.com"
NEXT_PUBLIC_ADMIN_PASSWORD="admin@test.com"

# NextAuth / Auth.js Configuration (generate with: npx auth secret)
AUTH_SECRET="selftest-super-secret-authjs-key-change-this"

# Google OAuth Provider (from Google Cloud Console)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth Provider (from GitHub Developer Settings -> OAuth Apps)
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"
